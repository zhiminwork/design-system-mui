{
  "name": "@zhiminwork/design-system-mui",
  "version": "0.2.0",
  "description": "Shared design system built on MUI",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "leaflet": ">=1.9",
    "react-leaflet": ">=4"
  },
  "devDependencies": {
    "@mui/material": "^9.0.1",
    "@mui/icons-material": "^9.0.1",
    "@mui/system": "^9.0.1",
    "@emotion/react": "^11.0.0",
    "@emotion/styled": "^11.0.0",
    "@types/react": "^19.0.0",
    "@types/leaflet": "^1.9.0",
    "leaflet": "^1.9.4",
    "react-leaflet": "^5.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
